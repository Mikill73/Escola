[{"id":"1786387535302","turma":"Terceiros Anos","materia":"Geografia","bimestre":"3","descricao":"<div>Conceitos Básicos</div><div><br></div><div>[color=yellow]Globalização:[/color] É um processo que determinam uma cadeia de fornecimentos, indústrias, empresas e setores econômicos e governos.</div><div>[color=yellow]Empresa:[/color] É um conjunto de atividades que determinam um ciclo de atividades, produção de bens e serviços.</div><div>[color=yellow]Estado:[/color] É um conjunto de órgãos e ações que determinam uma sociedade civil, política, etc.</div><div>[color=yellow]População:[/color] É um conjunto de pessoas que vivem em um determinado lugar ou território, com um conjunto de características (idade, gênero, etnia, etc.).</div><div>[color=yellow]Espaço:[/color] É um conjunto de elementos que compreende o mundo, a natureza, a paisagem, produzidos e transformados pelo homem.</div><div>[color=yellow]Paisagem:[/color] É um conjunto de elementos que compreende o meio ambiente, que modificam a natureza, transformam paisagens.</div><div>[color=yellow]Lugar:[/color] É um espaço onde se vive, se produz e se transforma, onde se desenvolvem as relações de parentesco, etc.</div><div>[color=yellow]Território:[/color] É um conjunto de elementos que compreende o espaço, a terra, onde ocorrem as ações de dominação e apropriação da paisagem.</div><div><br></div><div>Desenhos: Não há desenhos nesta página.</div>","resposta":"","criador":"Mikill","turmaCriador":"3A","autor_da_resposta":"","turma_autor_da_resposta":"","dataAdicao":"2026-08-10T18:45:35.302Z","oculta":false}]
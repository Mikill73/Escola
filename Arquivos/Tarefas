[{"id":"1786387535302","turma":"Terceiros Anos","materia":"Geografia","bimestre":"3","descricao":"<div>Conceitos Básicos</div><div><br></div><div><span style=\"color:yellow;\">Globalização:</span> É um processo que determinam uma cadeia de fornecimentos, indústrias, empresas e setores econômicos e governos.</div><div><span style=\"color:yellow;\">Empresa:</span> É um conjunto de atividades que determinam um ciclo de atividades, produção de bens e serviços.</div><div><span style=\"color:yellow;\">Estado:</span> É um conjunto de órgãos e ações que determinam uma sociedade civil, política, etc.</div><div><span style=\"color:yellow;\">População:</span> É um conjunto de pessoas que vivem em um determinado lugar ou território, com um conjunto de características (idade, gênero, etnia, etc.).</div><div><span style=\"color:yellow;\">Espaço:</span> É um conjunto de elementos que compreende o mundo, a natureza, a paisagem, produzidos e transformados pelo homem.</div><div><span style=\"color:yellow;\">Paisagem:</span> É um conjunto de elementos que compreende o meio ambiente, que modificam a natureza, transformam paisagens.</div><div><span style=\"color:yellow;\">Lugar:</span> É um espaço onde se vive, se produz e se transforma, onde se desenvolvem as relações de parentesco, etc.</div><div><span style=\"color:yellow;\">Território:</span> É um conjunto de elementos que compreende o espaço, a terra, onde ocorrem as ações de dominação e apropriação da paisagem.</div>","resposta":"<br>","criador":"Mikill","turmaCriador":"3A","autor_da_resposta":"Mikill","turma_autor_da_resposta":"3A","dataAdicao":"2026-08-10T18:45:35.302Z","oculta":false,"ultimaEdicao":"2026-08-10T18:49:17.333Z","editor":"Mikill","turmaEditor":"3A"}]